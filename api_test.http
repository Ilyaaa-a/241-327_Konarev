@hostname = http://localhost:8000

### запрос на Retrieve C(R)UD
GET {{hostname}}/cameras

###

### запрос на Retrieve C(R)UD
GET {{hostname}}/cameras/12
Content-Type: application/json

### запрос на Create (C)RUD
POST {{hostname}}/cameras
Content-Type: application/json

{
  "brand": "Leica",
  "release_year": 2026,
  "megapixels": "50.2",
  "sensor_type": "Full_Frame",
  "interchangeable_lens": true,
  "price": 900000
}

